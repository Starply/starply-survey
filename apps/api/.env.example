NODE_ENV=development
PORT=25200

# 国际化与时区（默认 zh-CN / Asia/Shanghai）
# 时间统一以 UTC 存储，展示时按租户时区换算；租户未配置时使用以下默认值
DEFAULT_LANGUAGE=zh-CN
DEFAULT_TIME_ZONE=Asia/Shanghai

# MySQL 8.4 LTS（TypeORM + mysql2，已接入）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=starply
# 连接池大小（默认 10；按应用实例数与 MySQL max_connections 调整）
MYSQL_POOL_SIZE=10

# Redis 6.2+（缓存与会话存储，队列将使用独立实例）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 访问令牌签名密钥（HS256），必填；缺失时 API 启动即失败
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 多个实例必须使用同一个值；轮换会导致所有已签发访问令牌立即失效
AUTH_ACCESS_TOKEN_SECRET=
