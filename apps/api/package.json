{
  "name": "@starply/api",
  "version": "0.0.0",
  "private": true,
  "description": "starply-survey HTTP API（NestJS）",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "pnpm build && node --env-file=.env ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "db:revert": "pnpm build && node --env-file=.env ./node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "db:seed:demo": "pnpm build && node --env-file=.env dist/database/seed-demo.js",
    "db:migration:generate": "pnpm build && node --env-file=.env ./node_modules/typeorm/cli.js migration:generate -d dist/database/data-source.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@starply/auth-core": "workspace:*",
    "@starply/contracts": "workspace:*",
    "@starply/dev-fixtures": "workspace:*",
    "@starply/questionnaire-core": "workspace:*",
    "@starply/tenancy-core": "workspace:*",
    "ioredis": "catalog:",
    "mysql2": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "typeorm": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
