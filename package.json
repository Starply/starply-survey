{
  "name": "starply-survey",
  "version": "0.0.0",
  "private": true,
  "description": "开源的现代 Web 端问卷系统",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @starply/web start",
    "dev:api": "pnpm --filter @starply/api start:dev",
    "build": "pnpm build:packages && pnpm build:api && pnpm build:web",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:api": "pnpm --filter @starply/api build",
    "build:web": "pnpm --filter @starply/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
